# 镜像：CI 推到 ghcr.io/<owner>/<repo>，填小写
XC_IMAGE_REPO=ghcr.io/your-org/xiachen-yishe
XC_API_TAG=latest
XC_ADMIN_TAG=latest

DB_URL=jdbc:mysql://127.0.0.1:3306/xiachen_yishe?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=xiachen
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=

WX_APPID_COST=
WX_SECRET_COST=
WX_APPID_XC=
WX_SECRET_XC=

# 图片存储：腾讯云 COS
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE=https://img.xiachen.xyz
# 同一桶内按环境分目录：本地 dev，生产 prod
COS_KEY_PREFIX=prod
