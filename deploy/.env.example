# 镜像：CI 推到 ghcr.io/<owner>/<repo>，填小写
XC_IMAGE_REPO=ghcr.io/your-org/xiachen-yishe
XC_API_TAG=latest
XC_ADMIN_TAG=latest
# Successful CI deployments persist per-service TCR digest references here.
XC_API_IMAGE=
XC_ADMIN_IMAGE=

DB_URL=jdbc:mysql://cost-cloud-mysql-1:3306/xiachen_yishe?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=xiachen
DB_PASSWORD=

REDIS_HOST=cost-cache-redis-1
REDIS_PORT=6379
REDIS_PASSWORD=

XC_API_JWT_SECRET=
XC_ADMIN_JWT_SECRET=

WX_APPID_COST=
WX_SECRET_COST=
WX_APPID_XC=wxc790fc208f0660c4
WX_SECRET_XC=

# 图片存储：腾讯云 COS
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE=https://img.xiachen.xyz
# 同一桶内按环境分目录：本地 dev，生产 prod
COS_KEY_PREFIX=prod

REDIS_USERNAME=
REDIS_DB=2
WX_MOCK=false
SPRING_PROFILES_ACTIVE=prod
XC_DATA_NETWORK=cost-cloud_default
XC_API_PORT=18091
XC_ADMIN_PORT=18092
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
