.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(246, 243, 238, 0.96);
  border-top: 1rpx solid rgba(28, 26, 23, 0.08);
  backdrop-filter: blur(20rpx);
}

.tabbar--transparent {
  background: transparent;
  border-top-color: transparent;
  backdrop-filter: none;
  color: #ffffff;
}

.tabbar__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8378;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.tabbar--transparent .tabbar__item {
  color: rgba(255, 255, 255, 0.72);
}

.tabbar__item.is-active {
  color: #1c1a17;
  font-weight: 600;
}

.tabbar--transparent .tabbar__item.is-active {
  color: #ffffff;
}
