.home {
  min-height: 100vh;
  background: var(--xc-bg);
}

.hero {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #2a2420;
}

.hero__img {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 48%, rgba(0, 0, 0, 0.62) 100%);
}

.hero__top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-left: 36rpx;
  padding-right: 36rpx;
  color: #ffffff;
  z-index: 2;
}

.brand {
  font-size: 40rpx;
  letter-spacing: 10rpx;
  font-weight: 600;
}

.brand__sub {
  display: block;
  margin-top: 6rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 16rpx;
  letter-spacing: 8rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero__copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  z-index: 2;
}

.hero__title {
  font-size: 52rpx;
  letter-spacing: 10rpx;
  font-weight: 600;
}

.hero__sub {
  margin-top: 18rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero__actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.hero__enter {
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.94);
}

.hero__arrow {
  margin-top: 40rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.82);
}

.content {
  padding-bottom: 20rpx;
}

.storebar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 46rpx 32rpx 16rpx;
}

.storebar__label {
  font-size: 30rpx;
  letter-spacing: 3rpx;
}

.storebar__hint {
  font-size: 19rpx;
  color: var(--xc-muted);
}

.section {
  padding: 44rpx 32rpx 8rpx;
}

.section__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section__title {
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--xc-ink);
}

.section__count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--xc-muted);
}

.section__sub {
  display: block;
  margin-top: 10rpx;
  margin-bottom: 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--xc-muted);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 20rpx;
  row-gap: 34rpx;
  margin-top: 18rpx;
}

.looks {
  margin-top: 18rpx;
  white-space: nowrap;
}

.looks__inner {
  display: inline-flex;
  gap: 20rpx;
}

.look {
  flex: none;
  width: 380rpx;
}

.look__img {
  width: 380rpx;
  height: 500rpx;
  border-radius: 12rpx;
  background: #e7e0d5;
}

.look__title {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--xc-ink);
  white-space: normal;
}

.look__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--xc-muted);
  white-space: normal;
}

.store {
  position: relative;
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 24rpx;
  border-radius: 14rpx;
  background: var(--xc-card);
}

.store__cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 10rpx;
  flex: none;
  background: #e7e0d5;
}

.store__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.store__name {
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.store__line {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--xc-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store__tag {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 18rpx;
  color: var(--xc-brand);
}

.footer {
  padding: 60rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--xc-muted);
}

.skeleton-page__hero {
  height: 100vh;
  border-radius: 0;
}
