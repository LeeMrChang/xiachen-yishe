<view class="page">
  <view class="head" style="padding-top: {{statusBarHeight + 24}}px;">
    <view class="head__avatar" bindtap="onHeadTap">
      <image wx:if="{{user && user.avatarUrl}}" class="head__avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text wx:else class="head__avatar-text serif">{{initial}}</text>
    </view>
    <view class="head__main">
      <view class="head__name-row" bindtap="onHeadTap">
        <text class="head__name serif">{{loggedIn ? user.nickname : '未登录'}}</text>
        <text class="head__edit" wx:if="{{loggedIn}}">编辑</text>
      </view>
      <text class="head__hint">{{loggedIn ? '收藏与点赞都保存在这个账号里' : '登录后同步收藏 · 点赞 · 足迹'}}</text>
    </view>
    <view class="head__action" wx:if="{{!loggedIn}}" bindtap="login">{{busy ? '登录中…' : '微信登录'}}</view>
    <view class="head__action head__action--ghost" wx:else bindtap="logout">退出</view>
  </view>

  <view class="entries">
    <view class="entries__item" data-url="/pages/footprints/index" bindtap="openEntry">
      <text class="entries__label serif">足迹</text>
      <text class="entries__hint">最近 30 天</text>
    </view>
    <view class="entries__item" data-url="/pages/appointments/index" bindtap="openEntry">
      <text class="entries__label serif">我的预约</text>
      <text class="entries__hint">到店试穿</text>
    </view>
  </view>

  <view class="tabs" wx:if="{{loggedIn}}">
    <view class="tabs__item {{tab === 1 ? 'is-active' : ''}}" data-tab="1" bindtap="switchTab">收藏</view>
    <view class="tabs__item {{tab === 2 ? 'is-active' : ''}}" data-tab="2" bindtap="switchTab">点赞</view>
  </view>

  <view class="list" wx:if="{{loggedIn && items.length}}">
    <view
      class="item"
      wx:for="{{items}}"
      wx:key="targetId"
      data-index="{{index}}"
      bindtap="openItem"
    >
      <image class="item__img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
      <view class="item__main">
        <text class="item__title">{{item.title}}</text>
        <text class="item__sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
        <view class="item__row">
          <text class="item__price" wx:if="{{item.showPrice}}">¥ {{item.priceText}}</text>
          <text class="item__type">{{item.targetType === 1 ? '商品' : '造型'}}</text>
        </view>
      </view>
      <text class="item__arrow">›</text>
    </view>
    <view class="more" wx:if="{{hasMore}}" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="more" wx:else>已经到底了 · 共 {{total}} 条</view>
  </view>

  <view class="empty" wx:if="{{loggedIn && !loading && !items.length}}">
    <text class="empty__title serif">{{tab === 1 ? '收藏夹还是空的' : '还没有点过赞'}}</text>
    <text class="empty__hint">{{tab === 1 ? '看到喜欢的款式，点一下商品页的收藏' : '喜欢就点商品页右上角的爱心'}}</text>
    <view class="empty__btn" bindtap="goHome">去逛逛</view>
  </view>

  <view class="guest" wx:if="{{!loggedIn && !loading}}">
    <text class="guest__title serif">登录后才有收藏夹</text>
    <text class="guest__hint">浏览不需要登录，登录只用于保存你的喜欢</text>
    <view class="guest__btn" bindtap="login">{{busy ? '登录中…' : '微信一键登录'}}</view>
  </view>

  <view class="safe-bottom"></view>
</view>
