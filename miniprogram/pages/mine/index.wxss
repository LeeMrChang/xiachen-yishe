.page {
  min-height: 100vh;
  background: var(--xc-bg);
}

.head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 36rpx;
}

.head__avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--xc-ink);
  color: #f6f3ee;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.head__avatar-img {
  width: 100%;
  height: 100%;
}

.head__avatar-text {
  font-size: 44rpx;
}

.head__main {
  flex: 1;
  min-width: 0;
}

.head__name-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.head__name {
  font-size: 38rpx;
  letter-spacing: 2rpx;
}

.head__edit {
  font-size: 20rpx;
  color: var(--xc-muted);
  border-bottom: 1rpx solid var(--xc-line);
}

.head__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--xc-muted);
}

.head__action {
  flex: none;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: var(--xc-ink);
  color: #f6f3ee;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.head__action--ghost {
  background: transparent;
  color: var(--xc-muted);
  border: 1rpx solid var(--xc-line);
  padding: 12rpx 26rpx;
}

.entries {
  display: flex;
  margin: 0 32rpx 28rpx;
  padding: 26rpx 0;
  border-radius: 16rpx;
  background: var(--xc-card);
}

.entries__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.entries__item + .entries__item {
  border-left: 1rpx solid var(--xc-line);
}

.entries__label {
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.entries__hint {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--xc-muted);
}

.tabs {
  display: flex;
  gap: 48rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--xc-line);
}

.tabs__item {
  position: relative;
  padding: 20rpx 0 22rpx;
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: var(--xc-muted);
}

.tabs__item.is-active {
  color: var(--xc-ink);
  font-weight: 600;
}

.tabs__item.is-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 3rpx;
  background: var(--xc-ink);
}

.list {
  padding: 10rpx 32rpx 0;
}

.item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--xc-line);
}

.item__img {
  width: 150rpx;
  height: 200rpx;
  border-radius: 10rpx;
  background: #e7e0d5;
  flex: none;
}

.item__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item__title {
  font-size: 27rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item__sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--xc-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 14rpx;
}

.item__price {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--xc-brand);
}

.item__type {
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: var(--xc-muted);
}

.item__arrow {
  flex: none;
  font-size: 32rpx;
  color: var(--xc-muted);
}

.more {
  padding: 40rpx 0 30rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--xc-muted);
}

.empty,
.guest {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 48rpx 0;
  text-align: center;
}

.empty__title,
.guest__title {
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.empty__hint,
.guest__hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--xc-muted);
}

.empty__btn,
.guest__btn {
  margin-top: 44rpx;
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--xc-ink);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
