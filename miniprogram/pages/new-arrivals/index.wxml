<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="nav__row">
      <text class="nav__title serif">上新</text>
      <text class="nav__count">{{total}} 款</text>
    </view>
    <text class="nav__sub">AW26 秋冬 · 三店同步</text>
  </view>

  <view class="bar">
    <store-switcher stores="{{stores}}" value="{{storeId}}" bind:change="onStoreChange" />
  </view>

  <view class="skeleton-grid" wx:if="{{loading}}">
    <view class="skeleton skeleton-grid__item" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"></view>
  </view>

  <view class="grid" wx:if="{{!loading && list.length}}">
    <product-card
      wx:for="{{list}}"
      wx:key="id"
      item="{{item}}"
      cardWidth="{{333}}"
    />
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text class="empty__title serif">本店暂无上新</text>
    <text class="empty__hint">切换其他门店看看</text>
  </view>

  <view class="end" wx:if="{{!loading && list.length}}">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{hasMore}}">上拉查看更多</text>
    <text wx:else>已经到底了 · 共 {{total}} 款</text>
  </view>
  <view class="safe-bottom"></view>
</view>
