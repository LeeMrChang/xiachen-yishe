.page {
  min-height: 100vh;
  background: var(--xc-bg);
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.gallery {
  position: relative;
  height: 900rpx;
  background: #e7e0d5;
}

.gallery__swiper {
  width: 100%;
  height: 100%;
}

.gallery__img {
  width: 100%;
  height: 100%;
}

.gallery__count {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(28, 26, 23, 0.45);
  color: #ffffff;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.nav {
  position: absolute;
  top: 0;
  left: 0;
  padding-left: 24rpx;
  z-index: 5;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  color: var(--xc-ink);
  font-size: 44rpx;
  line-height: 58rpx;
  text-align: center;
}

.body {
  padding: 34rpx 32rpx 0;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.price--main {
  font-size: 44rpx;
}

.price--origin {
  font-size: 24rpx;
  color: var(--xc-muted);
  text-decoration: line-through;
}

.price__likes {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--xc-muted);
}

.price__likes.is-on {
  color: var(--xc-brand);
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--xc-muted);
  letter-spacing: 1rpx;
}

.block {
  margin-top: 40rpx;
}

.block__label {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--xc-muted);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--xc-line);
  background: var(--xc-card);
  font-size: 24rpx;
  color: var(--xc-ink);
}

.chip.is-active {
  border-color: var(--xc-ink);
  background: var(--xc-ink);
  color: #f6f3ee;
}

.stock {
  margin-top: 30rpx;
}

.stock__text {
  font-size: 22rpx;
  color: var(--xc-muted);
}

.stock__text--out {
  color: var(--xc-brand);
}

.stock__text--low {
  color: #b4552d;
}

.stores {
  margin-top: 44rpx;
  padding: 26rpx 24rpx 6rpx;
  border-radius: 14rpx;
  background: var(--xc-card);
}

.stores__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.stores__title {
  font-size: 28rpx;
  letter-spacing: 3rpx;
}

.stores__hint {
  font-size: 18rpx;
  color: var(--xc-muted);
}

.store-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--xc-line);
}

.store-item__main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 20rpx;
}

.store-item__name {
  font-size: 24rpx;
}

.store-item.is-current .store-item__name {
  font-weight: 600;
}

.store-item__addr {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--xc-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-item__qty {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: none;
}

.store-item__num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--xc-ink);
}

.store-item__num.is-zero {
  color: var(--xc-muted);
}

.store-item__unit {
  font-size: 18rpx;
  color: var(--xc-muted);
}

.desc {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.desc__label {
  display: block;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--xc-muted);
}

.desc__text {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--xc-ink);
}

.desc__meta {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--xc-muted);
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(246, 243, 238, 0.96);
  border-top: 1rpx solid var(--xc-line);
  backdrop-filter: blur(16rpx);
}

.actions__icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 84rpx;
}

.actions__glyph {
  font-size: 30rpx;
  line-height: 1.2;
}

.actions__label {
  font-size: 18rpx;
  color: var(--xc-muted);
}

.actions__icon.is-on .actions__glyph,
.actions__icon.is-on .actions__label {
  color: var(--xc-brand);
}

.actions__main {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  background: var(--xc-ink);
  color: #f6f3ee;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.actions__main.is-in {
  background: transparent;
  color: var(--xc-ink);
  box-shadow: inset 0 0 0 1rpx var(--xc-ink);
}

.actions__sub {
  flex: none;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--xc-ink);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading__img {
  height: 900rpx;
  border-radius: 0;
}

.loading__body {
  padding: 34rpx 32rpx;
}

.loading__line {
  height: 30rpx;
  margin-bottom: 22rpx;
}
