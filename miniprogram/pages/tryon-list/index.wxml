<view class="page">
  <view class="head" style="padding-top: {{statusBarHeight + 18}}px;">
    <text class="head__title serif">试穿清单</text>
    <text class="head__hint">按门店分组 · 预约到店试穿</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton loading__row" wx:for="{{3}}" wx:key="*this"></view>
  </view>

  <view class="guest" wx:if="{{!loading && !loggedIn}}">
    <text class="guest__title serif">清单需要登录</text>
    <text class="guest__hint">登录后按门店分组保存，预约到店试穿</text>
    <view class="guest__btn" bindtap="login">{{busy ? '登录中…' : '微信一键登录'}}</view>
  </view>

  <block wx:if="{{!loading && loggedIn}}">
    <view class="empty" wx:if="{{!groups.length}}">
      <text class="empty__title serif">清单还是空的</text>
      <text class="empty__hint">在商品详情页点「加入试穿清单」</text>
      <view class="empty__btn" bindtap="goHome">去逛逛</view>
    </view>

    <view class="groups" wx:if="{{groups.length}}">
      <view class="group" wx:for="{{groups}}" wx:key="storeId" wx:for-item="group" wx:for-index="gi">
        <view class="group__head">
          <view class="group__store">
            <text class="group__name serif">{{group.storeName}}</text>
            <text class="group__addr">{{group.storeAddress}}</text>
          </view>
          <text class="group__count">{{group.checkedCount}} / {{group.items.length}} 件</text>
        </view>

        <view class="item" wx:for="{{group.items}}" wx:key="id" wx:for-item="item" wx:for-index="ii">
          <view class="check {{item.checked ? 'is-on' : ''}}" catchtap="toggleItem" data-g="{{gi}}" data-i="{{ii}}">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <image
            class="item__img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
            data-g="{{gi}}"
            data-i="{{ii}}"
            bindtap="openProduct"
          />
          <view class="item__main" data-g="{{gi}}" data-i="{{ii}}" bindtap="openProduct">
            <text class="item__title">{{item.title}}</text>
            <text class="item__spec">{{item.color}} · {{item.size}}</text>
            <view class="item__row">
              <text class="item__price">¥ {{item.priceText}}</text>
              <text class="item__stock {{item.stockStatus === 'OUT' ? 'is-out' : ''}}">{{item.stockLabel}}</text>
            </view>
          </view>
          <view class="item__more" catchtap="removeItem" data-g="{{gi}}" data-i="{{ii}}">···</view>
        </view>

        <view class="group__book" bindtap="openBookingForGroup" data-g="{{gi}}">
          <text class="group__book-store">{{group.storeShort}}</text>
          <text>预约这 {{group.checkedCount}} 件</text>
        </view>
      </view>
      <view class="notice">线上只展示款式与库存；预约不扣库存，到店报手机号即可。</view>
    </view>
  </block>

  <view class="bar" wx:if="{{!loading && loggedIn && groups.length}}">
    <view class="bar__sum">
      <text class="bar__num serif">{{totalChecked}}</text>
      <text class="bar__unit">件</text>
    </view>
    <view class="bar__cta" bindtap="openSheetFromBar">预约到店试穿</view>
  </view>

  <view class="mask" wx:if="{{sheet.show}}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{sheet.show}}">
    <view class="sheet__handle"></view>
    <view class="sheet__head">
      <view class="sheet__head-main">
        <text class="sheet__title serif">预约到店试穿</text>
        <text class="sheet__meta">{{sheet.storeName}} · {{sheet.items.length}} 件</text>
      </view>
      <view class="sheet__close" bindtap="closeSheet">×</view>
    </view>

    <scroll-view scroll-y class="sheet__items">
      <view class="sheet__item" wx:for="{{sheet.items}}" wx:key="id">
        <image class="sheet__img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="sheet__info">
          <text class="sheet__name">{{item.title}}</text>
          <text class="sheet__spec">{{item.color}} · {{item.size}} · ¥ {{item.priceText}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="field">
      <text class="field__label">到店日期</text>
      <picker class="field__picker" mode="date" value="{{sheet.date}}" start="{{sheet.minDate}}" end="{{sheet.maxDate}}" bindchange="onDateChange">
        <view class="field__value">{{sheet.dateLabel}}<text class="field__arrow">▾</text></view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">到店时间</text>
      <picker class="field__picker" mode="selector" range="{{sheet.times}}" value="{{sheet.timeIndex}}" bindchange="onTimeChange">
        <view class="field__value">{{sheet.times[sheet.timeIndex]}}<text class="field__arrow">▾</text></view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">手机号</text>
      <input class="field__input" type="number" maxlength="11" placeholder="到店联系用" value="{{sheet.phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <text class="field__label">称呼</text>
      <input class="field__input" maxlength="32" placeholder="怎么称呼你" value="{{sheet.contactName}}" bindinput="onContactInput" />
    </view>

    <view class="field">
      <text class="field__label">备注</text>
      <input class="field__input" maxlength="255" placeholder="想试的尺码、时间（选填）" value="{{sheet.remark}}" bindinput="onRemarkInput" />
    </view>

    <view class="sheet__tip">时间段按 30 分钟一档，不限人数；到店报手机号即可。</view>

    <view class="sheet__actions">
      <view class="btn btn--ghost" bindtap="closeSheet">取消</view>
      <view class="btn btn--solid {{sheet.submitting ? 'is-busy' : ''}}" bindtap="submitBooking">{{sheet.submitting ? '提交中…' : '确认预约'}}</view>
    </view>
  </view>
</view>
